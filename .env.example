# Microsoft SQL Server. Named instances use one backslash.
DB_SERVER=192.168.0.3\SQLEXPRESS
DB_DATABASE=DrishyamRealityDB
DB_USERNAME=YOUR_SQL_USERNAME
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Set DB_PORT only when using a fixed TCP port instead of SQL Browser discovery.
# DB_PORT=1433
ADMIN_EMAIL=admin@drishyam.example
ADMIN_NAME="Drishyam Administrator"
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Explicit preview fallback if the database is unavailable. Disable for launch.
DEMO_MODE=true
ALLOW_DEMO_SEED=false
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
